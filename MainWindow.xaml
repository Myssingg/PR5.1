<Window x:Class="ПР5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ПР5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Initialized="Window_Initialized">
    <StackPanel Orientation="Horizontal" Width="700">
        <ListBox Width="300" Margin="20" Height="250" Name="listBox"/>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="350">
            <Label x:Name="labelTitle" Margin="0,10,0,15"/>
            <Separator x:Name="separator1"/>
            <Label x:Name="labelBegst" Content="Название начального пунка назначения:" Margin="0,0,0,10"/>
            <TextBox x:Name="textBoxBegst"/>
            <Label x:Name="labelTerm" Content="Название конечного пунка назначения:" Margin="0,10,0,10"/>
            <TextBox x:Name="textBoxTerm"/>
            <Label x:Name="labelNumber" Content="Номер маршрута" Margin="0,10,0,10"/>
            <TextBox x:Name="textBoxNumber" Margin="0,0,0,10"/>
            <Separator  x:Name="separator2"/>
            <Button x:Name="buttonCreate" Content="Создать" Click="ButtonCreate_Click" Margin="0,10,0,10"/>

            <Separator Margin="0,20,0,20"/>
            <Button Content="Вывести информацию о маршруте" Click="ButtonInfo_Click" x:Name="buttonInfo" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
